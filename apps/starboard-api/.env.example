# Public origins used for OAuth redirects and browser CORS.
APP_URL=http://localhost:1337
WEB_APP_URL=http://localhost:5174

# Keep false for a private single-user self-host. Set true before exposing the API publicly.
AUTH_REQUIRED=false
SESSION_SECRET=replace-with-a-long-random-secret

# GitHub OAuth app credentials. Callback: ${APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPE=read:user repo

# Tangled public sync works with a handle. OAuth is optional and provider-instance specific.
TANGLED_BOBBIN_URL=https://api.tangled.org
TANGLED_RESOLVER_URL=https://public.api.bsky.app
TANGLED_CLIENT_ID=
TANGLED_AUTHORIZATION_URL=
TANGLED_TOKEN_URL=
TANGLED_SCOPE=atproto
TANGLED_CLIENT_SECRET=

# Optional OpenAI-compatible semantic indexer.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Optional OpenAI-compatible classifier.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional HMAC secret for x-starboard-signature webhook headers.
AUTOMATION_SIGNING_SECRET=
