# Public origin for this Starboard deployment. In local development, the API
# origin also serves as the browser app origin through the Vite proxy.
APP_URL=http://localhost:1337
WEB_APP_URL=http://localhost:1337

# Use a long random value. Production sessions are always authenticated.
SESSION_SECRET=replace-with-a-long-random-secret

# Create a GitHub App with user authorization enabled and the Starring user
# permission set to Read-only. Add this callback URL to the app registration:
# http://localhost:1337/api/auth/github/callback
# Production callback: https://<your-starboard-host>/api/auth/github/callback
# Set APP_URL and WEB_APP_URL to that same production origin.
# https://github.com/settings/apps/starboard-by-astahmer
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Tangled public sync works with a handle. OAuth is optional and instance-specific.
TANGLED_BOBBIN_URL=https://api.tangled.org
TANGLED_RESOLVER_URL=https://public.api.bsky.app
TANGLED_CLIENT_ID=
TANGLED_AUTHORIZATION_URL=
TANGLED_TOKEN_URL=
TANGLED_SCOPE=atproto
TANGLED_CLIENT_SECRET=

# Optional OpenAI-compatible semantic indexer.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Optional OpenAI-compatible classifier.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional HMAC secret for x-starboard-signature webhook headers.
AUTOMATION_SIGNING_SECRET=
